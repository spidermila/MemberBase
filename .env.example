# Copy to .env for `docker compose up` (standalone MemberBase dev stack).
SECRET_KEY=dev-secret-change-me
LDAP_KEYCLOAK_PASSWORD=dev-keycloak-ldap
LDAP_MEDCOVER_SYNC_PASSWORD=dev-medcover-sync
LDAP_MEMBERBASE_PASSWORD=dev-memberbase-ldap
MEMBERBASE_CLIENT_SECRET=dev-memberbase-client
MEDCOVER_CLIENT_SECRET=dev-medcover-client
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_NAME=Správce Evidence
# Initial password of the bootstrap admin (dev only; production uses the
# Keycloak "Zapomenuté heslo" flow instead).
BOOTSTRAP_ADMIN_PASSWORD=admin-heslo-123
KEYCLOAK_ADMIN_PASSWORD=admin
# Default browser-facing URLs (Keycloak's client settings). Other host names
# work too in the dev stack. Passkeys need a secure context: localhost (an SSH
# tunnel works) or HTTPS.
MEMBERBASE_URL=http://localhost:5100
MEDCOVER_URL=http://localhost:5000
